# Copy to .env for local docker compose usage. Never commit .env.
# Generate independent random secrets, for example:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-password
POSTGRES_DB=actfb
POSTGRES_PORT=5444

APP_PORT=8080
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Local-development-only RustFS credentials. Replace both with generated
# values for any shared/production environment, for example:
#   openssl rand -hex 16   # access key
#   openssl rand -hex 32   # secret key
RUSTFS_ACCESS_KEY=actfb-dev-access-key
RUSTFS_SECRET_KEY=actfb-dev-secret-key
S3_BUCKET=actfb

# Dev is plain HTTP. Set to true when serving over HTTPS (required in
# production) so refresh cookies carry the Secure flag.
APP_SECURE_COOKIES=false
# Comma-separated browser origins allowed by CORS/refresh-cookie checks. Keep
# these in sync with the frontend URL(s) you actually serve.
APP_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Mailpit SMTP/UI ports exposed on 127.0.0.1 only.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Address used in verification emails sent by the dev notification worker.
SMTP_FROM=no-reply@actfb.local

# Email verification is enabled by default in the dev stack. Set the period to
# a Go duration such as 15m or 1h; config validation caps it at 24h.
EMAIL_VERIFY_ENABLED=true
EMAIL_VERIFY_PERIOD=15m

# Backend auth rate limiting: memory (single-process legacy) or redis (shared).
# Compose backend defaults to redis; leave APP_TRUSTED_PROXIES empty unless the
# backend is behind an explicit reverse proxy.
AUTH_RATE_LIMIT_BACKEND=redis
APP_TRUSTED_PROXIES=
PASSWORD_RESET_PERIOD=15m

# Auth retention worker. Defaults match cmd/retention flags.
AUTH_RETENTION_DAYS=7
AUTH_RETENTION_INTERVAL=1h
AUTH_RETENTION_BATCH_SIZE=500
AUTH_RETENTION_MAX_BATCHES=100
AUTH_RETENTION_RUN_TIMEOUT=5m

# Optional least-privilege PostgreSQL override for retention deployments.
# Leave blank locally to reuse the development backend role. Production should
# provide a role limited to SELECT/DELETE on auth_sessions,
# auth_email_verifications, and auth_password_resets.
RETENTION_POSTGRES_USER=
RETENTION_POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Extended feature flags. Every value below is OFF/empty by default. Copy the
# keys you need into .env and generate independent random values; never reuse
# the JWT secrets and never commit a filled .env.
#
#   openssl rand -base64 32   # ACTFB_CREDENTIAL_ENCRYPTION_KEY
#   openssl rand -base64 32   # ACTFB_FILE_SCAN_KEY
#   openssl rand -base64 32   # ACTFB_PLUGIN_SERVICE_KEY
#   openssl rand -hex 32      # ACTFB_PLUGIN_RUNNER_TOKEN (>= 32 chars)
# ---------------------------------------------------------------------------

# General AES-256-GCM envelope key for integration credentials, deployment
# secrets and plugin settings. Required by runtime/integrations/plugins/AD.
ACTFB_CREDENTIAL_ENCRYPTION_KEY=
ACTFB_CREDENTIAL_KEY_VERSION=1

# Integration credential registry (admin /api/v2/admin/integrations).
ACTFB_INTEGRATIONS_ENABLED=false

# Deployment templates + instance/Pentest surfaces. Requires the credential key
# and the trusted runtime worker (cmd/instance-worker).
ACTFB_RUNTIME_ENABLED=false
ACTFB_INSTANCE_WORKER_DOCKER_SOCKET=/var/run/docker.sock
ACTFB_INSTANCE_WORKER_PODMAN_SOCKET=

# File submissions with S3 + NATS + ClamAV scanning.
ACTFB_FILES_ENABLED=false
ACTFB_FILE_SCAN_KEY=
CLAMAV_ADDRESS=clamav:3310
CLAMAV_REQUIRED=true

# Installable plugins. The asset origin is a separate loopback origin; the core
# API never serves plugin HTML. OCI execution requires the opt-in runner below.
ACTFB_PLUGINS_ENABLED=false
ACTFB_PLUGINS_DIR=/app/plugins
ACTFB_PLUGIN_SERVICE_KEY=
ACTFB_PLUGIN_IFRAME_ORIGIN=http://127.0.0.2:8091
ACTFB_PLUGIN_ASSET_ADDR=127.0.0.2:8091
PLUGIN_ASSET_PORT=8091
ACTFB_PLUGIN_ALLOW_EXEC=false
# trusted-js executes plugin JS with platform-origin capabilities. Keep false
# unless the operator accepts that risk; install still requires explicit
# per-package approval.
ACTFB_PLUGIN_ALLOW_TRUSTED_JS=false
ACTFB_PLUGIN_RUNNER_URL=
ACTFB_PLUGIN_RUNNER_TOKEN=
ACTFB_PLUGIN_CORE_SDK_URL=
ACTFB_PLUGIN_RUNNER_NETWORK=actfb_actfb-net
# Stable, unique per trusted runner; scopes orphan-container reconciliation.
ACTFB_PLUGIN_RUNNER_ID=actfb-plugin-runner

# Attack+Defense. The HTTP backend only queues ids-only jobs; checks run in
# cmd/ad-worker with git, Docker CLI and an operator-pinned image allowlist.
ACTFB_AD_ENABLED=false
ACTFB_AD_RUNNER_IMAGES=
ACTFB_AD_WEBHOOK_BASE_URL=
ACTFB_AD_ALLOW_INSECURE_LOOPBACK=false
