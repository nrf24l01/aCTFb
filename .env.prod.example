# Copy to .env.prod and fill every empty secret. Never commit the filled file.
# Generate independent values, for example:
#   openssl rand -base64 48
POSTGRES_USER=actfb
POSTGRES_PASSWORD=
POSTGRES_DB=actfb

# Distinct, at least 32 characters each. Never reuse one for both.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Host port for the frontend only. The backend, PostgreSQL, Redis, and NATS stay
# on the private Compose network.
APP_PORT=8080

# Production must be served over TLS. Keep true outside a loopback smoke.
APP_SECURE_COOKIES=true
# Exact public origin when it differs from the same-origin frontend, e.g.
# https://ctf.example. Leave empty for same-origin-only deployment.
APP_ALLOWED_ORIGINS=
# Comma-separated trusted proxy CIDRs if an external TLS proxy fronts nginx.
APP_TRUSTED_PROXIES=

# Image tag selection. Use latest for the initial quickstart; pin sha-<full-sha>
# for rollback and reproducible deployments.
ACTFB_IMAGE_TAG=latest

# Optional email delivery. The default production Compose baseline does not
# start the notification worker and leaves email verification/password reset
# unavailable until these values and the `email` profile are configured.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFY_ENABLED=false

# Optional retention tuning.
AUTH_RETENTION_DAYS=7
AUTH_RETENTION_INTERVAL=1h