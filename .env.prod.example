# Copy to .env.prod and fill every empty secret. Never commit the filled file.
# Generate independent values, for example:
#   openssl rand -base64 48   # JWT secrets
#   openssl rand -base64 32   # credential/scan/plugin service keys
#   openssl rand -hex 32      # plugin runner token (>= 32 chars)
POSTGRES_USER=actfb
POSTGRES_PASSWORD=
POSTGRES_DB=actfb

# Distinct, at least 32 characters each. Never reuse one for both.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Host port for the frontend only. The backend, PostgreSQL, Redis, and NATS stay
# on the private Compose network.
APP_PORT=8080

# Production must be served over TLS. Keep true outside a loopback smoke.
APP_SECURE_COOKIES=true
# REQUIRED. The exact public browser origin, including a non-default port.
# Replace this example. It must match the URL users open, e.g.
# https://ctf.example or https://ctf.example:8443. Do not leave it empty.
APP_ALLOWED_ORIGINS=https://ctf.example:8443

# One value drives both the Docker proxy-network subnet and the backend's
# trusted-proxy CIDR. Override only if 10.213.77.0/28 collides with the host.
ACTFB_PROXY_SUBNET=10.213.77.0/28

# Image tag selection. Use latest for the initial quickstart; pin sha-<full-sha>
# for rollback and reproducible deployments.
ACTFB_IMAGE_TAG=latest

# Optional email delivery. The default production Compose baseline does not
# start the notification worker and leaves email verification/password reset
# unavailable until these values and the `email` profile are configured.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFY_ENABLED=false

# Optional retention tuning.
AUTH_RETENTION_DAYS=7
AUTH_RETENTION_INTERVAL=1h

# Trusted socket-worker profiles. The GID must match the host Docker socket
# group: stat -c %g /var/run/docker.sock
ACTFB_DOCKER_GID=999
ACTFB_PLUGIN_RUNNER_NETWORK=actfb-prod_actfb-net

# Optional files profile. These settings do NOT enable the backend feature by
# themselves: set ACTFB_FILES_ENABLED=true and configure S3 + ClamAV + key.
ACTFB_FILES_ENABLED=false
ACTFB_FILE_SCAN_KEY=
S3_ENDPOINT=
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ADDRESSING_STYLE=
CLAMAV_ADDRESS=
CLAMAV_REQUIRED=true

# Optional plugins profile. The frontend asset-origin caveat still applies.
# When enabled, set the service key and the runner token together. The runner
# control endpoint is loopback inside the backend network namespace.
ACTFB_PLUGINS_ENABLED=false
ACTFB_PLUGIN_SERVICE_KEY=
ACTFB_PLUGIN_RUNNER_URL=http://127.0.0.2:8092
ACTFB_PLUGIN_RUNNER_TOKEN=

# Optional trusted runtime/A+D profiles. These flags do not provision
# credentials or pinned checker images.
ACTFB_RUNTIME_ENABLED=false
ACTFB_INTEGRATIONS_ENABLED=false
ACTFB_CREDENTIAL_ENCRYPTION_KEY=
ACTFB_CREDENTIAL_KEY_VERSION=1
ACTFB_AD_ENABLED=false
ACTFB_AD_RUNNER_IMAGES=
ACTFB_AD_WEBHOOK_BASE_URL=
ACTFB_AD_ALLOW_INSECURE_LOOPBACK=false

# Optional least-privilege PostgreSQL worker overrides. These variables do NOT
# create roles; unset values fall back to the shared POSTGRES_USER baseline.
# RETENTION_POSTGRES_USER=
# RETENTION_POSTGRES_PASSWORD=
# EVENTS_POSTGRES_USER=
# EVENTS_POSTGRES_PASSWORD=
# SCANNER_POSTGRES_USER=
# SCANNER_POSTGRES_PASSWORD=
# AD_POSTGRES_USER=
# AD_POSTGRES_PASSWORD=
# RUNTIME_POSTGRES_USER=
# RUNTIME_POSTGRES_PASSWORD=