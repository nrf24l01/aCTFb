@startuml architecture

skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam arrowColor #666666

cloud Runtime {
    [Proxmox] as proxmox #ff7300
    [Docker] as docker #0db7ed
    [Kubernetes] as kubernetes #326ce5
}

package "Datastore" {
    database "Postgres" as postgres #1869ff
    queue "Nats" as mq #FC6D26
    database "Redis" as redis #D82C20
    database "Minio" as minio #CF163D
}

package "Backend" {
    [HTTP backend] as backend #00ADD8
    [Email worker] as emailWorker #00ADD8
    [Container runner] as containerRunner #00ADD8
}

package "Frontend" {
    [Web app] as webApp #FF6F61
}

webApp --> backend : "HTTP requests"
backend --> postgres : "Read/Write data"
backend --> minio : "Create presigned URLs"
frontend --> minio : "Download/upload files"
backend --> mq : "Emails to send"
backend --> mq : "Container actions\nsend user:task:action"
backend --> redis : "Cache data"

containerRunner --> Runtime : "Run tasks"

mq --> emailWorker : "Consume email tasks"

mq --> containerRunner : "Consume container tasks"
containerRunner --> postgres : "Status of container"

@enduml