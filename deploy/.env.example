# Copy to .env and fill the three empty secrets. Never commit the filled file.
# Generate independent values (never reuse one):
#   openssl rand -hex 32   # POSTGRES_PASSWORD
#   openssl rand -hex 48   # JWT_ACCESS_SECRET
#   openssl rand -hex 48   # JWT_REFRESH_SECRET
POSTGRES_USER=actfb
POSTGRES_PASSWORD=
POSTGRES_DB=actfb

# Two distinct values, at least 32 characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Host port for the frontend only. The container port stays 8080 and the bind is
# fixed to 127.0.0.1. Change this if 8080 is already in use.
HOST_PORT=8080

# Production public HTTPS requires the exact browser origin, including a
# non-default port, and secure cookies. Do not leave this blank and do not add a
# trailing slash or path.
APP_SECURE_COOKIES=true
APP_ALLOWED_ORIGINS=https://ctf.example:8443

# Local loopback demo ONLY (plain HTTP, no TLS): replace the two lines above with
#   APP_SECURE_COOKIES=false
#   APP_ALLOWED_ORIGINS=http://localhost:8080
# Then open http://localhost:8080, not a different host name. Never expose this
# plain-HTTP mode outside the local machine.

# One value drives both the Docker proxy-network subnet and the backend trusted
# proxy CIDR. Override only if 10.213.77.0/28 collides with the host network.
ACTFB_PROXY_SUBNET=10.213.77.0/28

# latest is the simple default. For a reproducible deployment, pin the same
# immutable tag for every image, for example:
#   ACTFB_IMAGE_TAG=sha-21912820d814d87abde92c4f47333c7a1534a5e5
ACTFB_IMAGE_TAG=latest

# Optional email delivery. The default Compose baseline does not start the
# notification worker; email verification and password-reset email stay
# unavailable until SMTP is configured and the `email` profile is enabled.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFY_ENABLED=false

# Optional retention tuning.
AUTH_RETENTION_DAYS=7
AUTH_RETENTION_INTERVAL=1h

# Trusted socket workers. The GID must match the host Docker socket group:
#   stat -c %g /var/run/docker.sock
ACTFB_DOCKER_GID=999
ACTFB_PLUGIN_RUNNER_NETWORK=actfb-prod_actfb-net

# Optional profile keys, generate only when enabling the matching profile:
#   ACTFB_FILE_SCAN_KEY=$(openssl rand -base64 32)
#   ACTFB_CREDENTIAL_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   ACTFB_PLUGIN_SERVICE_KEY=$(openssl rand -base64 32)
#   ACTFB_PLUGIN_RUNNER_TOKEN=$(openssl rand -hex 32)

# Optional files profile. A profile alone does not enable the backend feature.
ACTFB_FILES_ENABLED=false
ACTFB_FILE_SCAN_KEY=
S3_ENDPOINT=
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ADDRESSING_STYLE=
CLAMAV_ADDRESS=
CLAMAV_REQUIRED=true

# Optional plugins profile. Set the service key and runner token together.
ACTFB_PLUGINS_ENABLED=false
ACTFB_PLUGIN_SERVICE_KEY=
ACTFB_PLUGIN_RUNNER_URL=http://127.0.0.2:8092
ACTFB_PLUGIN_RUNNER_TOKEN=

# Optional trusted runtime/A+D profiles. These flags do not provision credentials
# or pinned checker images.
ACTFB_RUNTIME_ENABLED=false
ACTFB_INTEGRATIONS_ENABLED=false
ACTFB_CREDENTIAL_ENCRYPTION_KEY=
ACTFB_CREDENTIAL_KEY_VERSION=1
ACTFB_AD_ENABLED=false
ACTFB_AD_RUNNER_IMAGES=
ACTFB_AD_WEBHOOK_BASE_URL=
ACTFB_AD_ALLOW_INSECURE_LOOPBACK=false

# Optional least-privilege PostgreSQL worker overrides. These variables do NOT
# create roles; unset values fall back to the shared POSTGRES_USER baseline.
# RETENTION_POSTGRES_USER=
# RETENTION_POSTGRES_PASSWORD=
# EVENTS_POSTGRES_USER=
# EVENTS_POSTGRES_PASSWORD=
# SCANNER_POSTGRES_USER=
# SCANNER_POSTGRES_PASSWORD=
# AD_POSTGRES_USER=
# AD_POSTGRES_PASSWORD=
# RUNTIME_POSTGRES_USER=
# RUNTIME_POSTGRES_PASSWORD=