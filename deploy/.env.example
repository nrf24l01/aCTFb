# Datasource connections/secrets and Docker-specific settings only.
# Application settings, JWT, cookies/origins, feature flags, app secrets, and
# worker limits live in config.yaml. Never put JWT/APP/AUTH/ACTFB_* overrides
# here; the production Compose file does not consume them.
#
# This file is for the operator deployment directory, not the repository.
POSTGRES_USER=actfb
POSTGRES_PASSWORD=
POSTGRES_DB=actfb
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC

# Docker publish and image selection.
HOST_PORT=8080
ACTFB_IMAGE_TAG=latest
# For a reproducible deployment, pin one immutable tag for every image.
# Use the full SHA recorded in docs/ghcr-verification.md, for example:
#   ACTFB_IMAGE_TAG=sha-<full-git-sha>

# Docker proxy-network CIDR. It MUST match web_app.trusted_proxies in
# config.yaml; change both together if this collides with the host network.
ACTFB_PROXY_SUBNET=10.213.77.0/28

# Trusted socket workers. The GID must match the host Docker socket group:
#   stat -c %g /var/run/docker.sock
ACTFB_DOCKER_GID=999
ACTFB_PLUGIN_RUNNER_NETWORK=actfb-prod_actfb-net

# Optional SMTP datasource. Enable email/verification in config.yaml, not here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional S3-compatible datasource for file submissions.
S3_ENDPOINT=
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ADDRESSING_STYLE=

# Optional ClamAV datasource.
CLAMAV_ADDRESS=

# Optional least-privilege PostgreSQL worker overrides. These variables do NOT
# create roles; unset values fall back to the shared POSTGRES_USER baseline.
# RETENTION_POSTGRES_USER=
# RETENTION_POSTGRES_PASSWORD=
# EVENTS_POSTGRES_USER=
# EVENTS_POSTGRES_PASSWORD=
# SCANNER_POSTGRES_USER=
# SCANNER_POSTGRES_PASSWORD=
# AD_POSTGRES_USER=
# AD_POSTGRES_PASSWORD=
# RUNTIME_POSTGRES_USER=
# RUNTIME_POSTGRES_PASSWORD=